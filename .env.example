COMPOSE_PROJECT_NAME=create_sheme
POSTGRES_USER=solution
POSTGRES_PASSWORD=solution
POSTGRES_DB=solution
PORT=3001
IMPORT_MAX_BYTES=1073741824
IMPORT_MAX_XML_BYTES=1073741824
HTTP_READ_HEADER_TIMEOUT=30s
HTTP_READ_TIMEOUT=30m
HTTP_WRITE_TIMEOUT=30m
HTTP_IDLE_TIMEOUT=120s

# Go runtime soft memory limit (go.dev/doc/gc-guide); docker-compose api uses 10GiB with 11g mem_limit
GOMEMLIMIT=10GiB
# GC heap growth target in percent; 100 is the Go default
GOGC=100

# Redis cache (empty = NopCache / fail-open)
REDIS_URL=redis://localhost:6379/0
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
CACHE_SCHEME_TTL=15m
CACHE_SCHEME_OBJECTS_TTL=15m
CACHE_COMPLIANCE_TTL=5m
CACHE_MAX_VALUE_BYTES=2097152
